{
  "buildCommand": null,
  "installCommand": "",
  "outputDirectory": ".",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "maxDuration": 30,
      "memory": 1024,
      "includeFiles": "{**/*.php,manifest.json,sw.js,downloads/**}",
      "excludeFiles": "{images/**,WhatsApp/vendor/**,WhatsApp/composer.phar}"
    }
  },
  "routes": [
    {
      "src": "^/(.*)$",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "SAMEORIGIN",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Cache-Control": "no-store, no-cache, must-revalidate",
        "Permissions-Policy": "camera=(self), microphone=(self), geolocation=()"
      },
      "continue": true
    },
    {
      "src": "^/(images|assets|uploads)/(.*)$",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "^/(.*\\.(woff2|ttf|webp|png|jpg|jpeg|gif|svg|ico))$",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "^/(.*\\.(css|js))$",
      "headers": {
        "Cache-Control": "public, max-age=86400, stale-while-revalidate=604800"
      },
      "continue": true
    },
    {
      "src": "^/manifest\\.(json|webmanifest)$",
      "headers": {
        "Content-Type": "application/manifest+json; charset=utf-8",
        "Access-Control-Allow-Origin": "*"
      },
      "continue": true
    },
    {
      "src": "^/sw\\.js$",
      "headers": {
        "Content-Type": "application/javascript; charset=utf-8",
        "Service-Worker-Allowed": "/",
        "Cache-Control": "no-cache, no-store, must-revalidate"
      },
      "continue": true
    },
    {
      "src": "^/(images|assets|uploads/products)/(.*)$",
      "dest": "/$1/$2"
    },
    {
      "src": "^/manifest\\.json$",
      "dest": "/api/index.php"
    },
    {
      "src": "^/manifest\\.webmanifest$",
      "dest": "/api/index.php"
    },
    {
      "src": "^/sw\\.js$",
      "dest": "/api/index.php"
    },
    {
      "src": "^/downloads/(.*)$",
      "dest": "/api/index.php"
    },
    {
      "src": "^/(.*\\.(css|js|png|jpg|jpeg|gif|svg|ico|webp|woff|woff2|ttf|eot|webmanifest|mp3|wav))$",
      "dest": "/$1"
    },
    {
      "src": "^/api/payment/(.*)$",
      "dest": "/api/index.php"
    },
    {
      "src": "^/payment-methods/(.*)$",
      "dest": "/api/index.php"
    },
    {
      "src": "^/(.*)$",
      "dest": "/api/index.php"
    }
  ]
}
