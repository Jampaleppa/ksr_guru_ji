# ============================================================
# KSR GURU JI — Environment Variable Reference
# Copy this file to .env (never commit .env to git)
# ============================================================

# ----- Application Environment -----
# Set to "production" in production. Enables error display only in "development".
KSR_ENV=production
APP_ENV=production

# ----- Database (MySQL / PlanetScale / Railway / Cloud SQL) -----
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ksr_guru_ji
DB_USER=your_db_username
DB_PASS=your_db_password
# For SSL-verified connections (recommended in production):
DB_SSL_CA=/path/to/ca-cert.pem

# ----- Razorpay Payment Gateway -----
# Get these from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_live_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ----- Admin Accounts (used by seed scripts only — run via CLI) -----
ADMIN_SUPER_PASS=choose_a_strong_password_here
ADMIN_DEFAULT_PASS=choose_a_strong_password_here

# ----- Delivery Accounts (used by seed scripts only — run via CLI) -----
DELIVERY_DEFAULT_PASS=choose_a_strong_password_here

# ----- Internal API Key -----
# Used internally between services. Generate with: php -r "echo bin2hex(random_bytes(24));"
KSR_INTERNAL_API_KEY=generate_with_random_bytes

# ----- Debug / Diagnostic Endpoints -----
# DO NOT set these in production — leave unset or empty.
# ENABLE_DEBUG_ENDPOINT=true
# DEBUG_TOKEN=your_secret_debug_header_value

# ----- Mock / Test Payments -----
# DO NOT set in production. Only for local development.
# ALLOW_MOCK_PAYMENTS=true

# ----- CORS Allowed Origin -----
# Your production domain (without trailing slash)
CORS_ALLOWED_ORIGIN=https://ksrguruji.in

# ----- WhatsApp / Telehealth (if enabled) -----
WHATSAPP_API_KEY=
TELEHEALTH_DB_HOST=
TELEHEALTH_DB_USER=
TELEHEALTH_DB_PASS=
TELEHEALTH_DB_NAME=

