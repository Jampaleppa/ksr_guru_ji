Options -Indexes

# ── URL Rewriting ──────────────────────────────────────────────────────────────
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Explicit routing for checkout and cart directories
    RewriteRule ^checkout/?$ checkout.php [NC,L]
    RewriteRule ^cart/?$ cart.php [NC,L]

    # Support extensionless PHP URLs (e.g., /cart -> /cart.php, /checkout -> /checkout.php)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.php -f
    RewriteRule ^([^\.]+)$ $1.php [NC,L]

    # Skip existing files and directories
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Route fallback to index.php
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>

# ── PWA / Service Worker & Mobile App Downloads ────────────────────────────────
<IfModule mod_mime.c>
    AddType application/vnd.android.package-archive .apk
    AddType application/octet-stream .aab
    AddType application/x-apple-aspen-config .mobileconfig
    AddType application/manifest+json .json
</IfModule>

<IfModule mod_headers.c>
    # Direct binary downloads attachment header
    <FilesMatch "\.(apk|aab|mobileconfig)$">
        Header set Content-Disposition "attachment"
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>

    # Service Worker — must be served with no-cache so updates are detected
    <FilesMatch "^sw\.js$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Service-Worker-Allowed "/"
    </FilesMatch>

    # Web App Manifest
    <FilesMatch "^manifest\.json$">
        Header set Cache-Control "no-cache"
        Header set Content-Type "application/manifest+json"
    </FilesMatch>

    # Security headers (helps PWA trust)
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # CORS for fonts and icons (needed for PWA icon serving)
    <FilesMatch "\.(png|jpg|jpeg|svg|ico|webp|woff|woff2|ttf)$">
        Header set Access-Control-Allow-Origin "*"
    </FilesMatch>
</IfModule>

# ── Compression ────────────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json text/plain application/manifest+json
</IfModule>

# ── Browser Caching ────────────────────────────────────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg   "access plus 1 month"
    ExpiresByType image/png    "access plus 1 month"
    ExpiresByType image/webp   "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType text/css     "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType application/json "access plus 0 seconds"
    # PWA manifest — short cache so updates propagate
    <FilesMatch "manifest\.json">
        ExpiresDefault "access plus 1 hour"
    </FilesMatch>
</IfModule>
<FilesMatch ^[.]>
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<FilesMatch "(?i)\.(?:sql|log|err|sqlite|phar|dist|yaml|yml)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<FilesMatch "(?i)^(?:_.*|tmp[-_].*|test.*|debug.*|cron_.*|check_db|check_abs_paths|show_(?:cols|order_delivery|tables)|schema_print2?|spider_test|lint_all|create_admins|create_db_tables|import_db|migrate(?:_db)?|run_(?:migration_audit_logs|patient_portal_migration)|seed_doctors|seed-telehealth-data|sanitize_db|fix_.*|inject_sorting|merge_doctor_assist|patch_session|standardize_.*|update_(?:all_headers|company_logo)|test_whatsapp_sql|run_tests|lint)\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<FilesMatch "(?i)^(?:database|db_categories_dump|schema(?:_order_delivery)?|simulation_run_output|validation_output|enhancement_log|logo_log)\.txt$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>